# Exemple de configuration — à copier en `.env` sur le VPS (jamais committé).
# `docker compose` lit ce fichier ; il refuse de démarrer si un secret marqué requis manque.

# --- Requis ---
# ⚠️ Sur un volume Postgres DÉJÀ initialisé, le mot de passe de l'utilisateur `zombieland`
# a été fixé à la création du volume (historiquement `zombieland`). POSTGRES_PASSWORD n'est
# appliqué qu'à la PREMIÈRE init du volume : mettre ici la valeur ACTUELLE (`zombieland`)
# pour ne pas casser la connexion, OU faire `ALTER USER zombieland WITH PASSWORD '...'`
# dans le conteneur postgres avant de changer cette valeur.
POSTGRES_PASSWORD=zombieland
JWT_SECRET=openssl-rand-hex-32
SESSION_SECRET=openssl-rand-hex-32

# --- Optionnels ---
JWT_EXPIRY=7d
ADMIN_EMAIL=admin@zombieland.fr
# Si vide, un mot de passe admin aléatoire est généré au seed et affiché dans les logs.
ADMIN_PASSWORD=
MAIL=
MAIL_PASSWORD=
VITE_NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
VITE_NEXT_PUBLIC_STRIPE_PRICE_ID=
